{
  "name": "ghmaas-private-admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "password": "node dist/password.js",
    "start": "node --env-file=.env dist/server.js",
    "test": "npm run build && node --test tests/admin.test.mjs",
    "test:browser": "npm run build && node --test tests/browser.test.mjs",
    "verify:live": "node --env-file=.env dist/verify.js",
    "test:public": "node --test tests/public.test.mjs"
  },
  "dependencies": {
    "cookie": "1.1.1",
    "express": "5.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  }
}
