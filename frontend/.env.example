# Server-side Vite proxy target. A bare HTTP(S) origin, without credentials.
AZURACAST_ORIGIN=http://localhost

# Public build settings. Leave the stream override empty for /listen/<station>/radio.mp3.
VITE_AZURACAST_STATION=ghmaas_baladi_radio
VITE_STREAM_URL=
# Optional HTTPS origin for the links operators share with branches.
VITE_PUBLIC_RADIO_ORIGIN=

# Enable only for the separate private dist-admin build.
VITE_ADMIN_ENABLED=false
